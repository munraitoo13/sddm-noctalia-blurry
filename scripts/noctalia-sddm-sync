#!/usr/bin/env bash
set -euo pipefail

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/noctalia-sddm/config"
SYSTEM_DIR="/var/lib/noctalia-sddm"
STATE_FALLBACK="${XDG_STATE_HOME:-$HOME/.local/state}/noctalia-sddm"

MONITOR=""
BLUR_SIGMA="18"
RESIZE_MAX="1920x1080>"
MODULATE="94,108,100"
SYNC_WALLPAPER="true"
SYNC_COLORS="true"

if [ -f "$CONFIG_FILE" ]; then
    # shellcheck source=/dev/null
    . "$CONFIG_FILE"
fi

preview_dir=""
avatar_src=""
force_sync=0

usage() {
    cat <<'EOF'
Usage: noctalia-sddm-sync [OPTIONS]

Sync the active Noctalia wallpaper (Gaussian blurred) and color palette to SDDM.

Options:
  --force            Force re-rendering even if source files appear unchanged
  --preview <dir>    Write synced assets into <dir> instead of /var/lib/noctalia-sddm
  --avatar <image>   Crop and mask <image> into a 256x256 circular avatar.png
  --no-wallpaper     Skip wallpaper sync
  --no-colors        Skip color palette sync
  -h, --help         Show this help message
EOF
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --force)        force_sync=1 ;;
        --no-wallpaper) SYNC_WALLPAPER="false" ;;
        --no-colors)    SYNC_COLORS="false" ;;
        --preview)
            shift
            [ "$#" -gt 0 ] || { echo "Error: --preview requires a directory path" >&2; exit 2; }
            preview_dir="$1"
            ;;
        --avatar)
            shift
            [ "$#" -gt 0 ] || { echo "Error: --avatar requires an image path" >&2; exit 2; }
            avatar_src="$1"
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
    shift
done

resolve_target_dir() {
    if [ -n "$preview_dir" ]; then
        printf '%s\n' "$preview_dir"
    elif [ -d "$SYSTEM_DIR" ] && [ -w "$SYSTEM_DIR" ]; then
        printf '%s\n' "$SYSTEM_DIR"
    else
        printf '%s\n' "$STATE_FALLBACK"
    fi
}

target_dir="$(resolve_target_dir)"
mkdir -p "$target_dir"

detect_primary_monitor() {
    if [ -n "$MONITOR" ]; then
        printf '%s\n' "$MONITOR"
        return 0
    fi
    if command -v hyprctl >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
        hyprctl monitors -j 2>/dev/null | python3 -c '
import json, sys
try:
    mons = json.load(sys.stdin)
    if isinstance(mons, list) and mons:
        focused = [m for m in mons if m.get("focused")]
        chosen = focused[0] if focused else mons[0]
        name = chosen.get("name", "")
        if name:
            print(name)
except Exception:
    pass
' || true
    fi
}

get_wallpaper() {
    local mon out=""
    command -v noctalia >/dev/null 2>&1 || return 0
    mon="$(detect_primary_monitor)"
    if [ -n "$mon" ]; then
        out="$(noctalia msg wallpaper-get "$mon" 2>/dev/null || true)"
    fi
    if [ -z "$out" ]; then
        out="$(noctalia msg wallpaper-get 2>/dev/null || true)"
    fi
    printf '%s\n' "$out" | sed -e '/^[[:space:]]*$/d' -e 's/^[[:space:]]*//;s/[[:space:]]*$//' | head -n 1
}

sync_avatar() {
    local src="$1"
    src="${src#file://}"
    if [ ! -f "$src" ]; then
        echo "Error: avatar image not found: $src" >&2
        exit 1
    fi
    command -v magick >/dev/null 2>&1 || { echo "Error: ImageMagick (magick) is required for --avatar" >&2; exit 1; }

    local tmp
    tmp="$(mktemp "$target_dir/.avatar.XXXXXX.png")"
    trap 'rm -f "$tmp"' RETURN

    magick "$src" \
        -auto-orient -resize 256x256^ -gravity center -extent 256x256 \
        \( -size 256x256 xc:black -fill white -draw "circle 127.5,127.5 127.5,0.5" \) \
        -alpha off -compose CopyOpacity -composite \
        "PNG32:$tmp"

    chmod 644 "$tmp"
    mv -f "$tmp" "$target_dir/avatar.png"
}

sync_wallpaper() {
    local wall="$1"
    [ -n "$wall" ] && [ -f "$wall" ] || return 0

    local dest_file="$target_dir/wallpaper.png"
    local stamp_file="$target_dir/.last_wallpaper"
    local src_stat current_stamp

    src_stat="$(stat -c '%n|%Y|%s' "$wall" 2>/dev/null || printf '%s' "$wall")"
    current_stamp="v1-blur${BLUR_SIGMA}|${RESIZE_MAX}|${MODULATE}|${src_stat}"

    if [ "$force_sync" -eq 0 ] && [ -f "$dest_file" ] && [ -f "$stamp_file" ]; then
        if [ "$(cat "$stamp_file" 2>/dev/null || true)" = "$current_stamp" ]; then
            return 0
        fi
    fi

    local tmp_file
    tmp_file="$(mktemp "$target_dir/.wallpaper.XXXXXX.png")"
    trap 'rm -f "$tmp_file"' RETURN

    if command -v magick >/dev/null 2>&1; then
        if ! magick "$wall" \
            -auto-orient -strip \
            -resize "$RESIZE_MAX" \
            -blur "0x${BLUR_SIGMA}" \
            -modulate "$MODULATE" \
            -define png:compression-level=6 \
            "$tmp_file" 2>/dev/null; then
            cp -f "$wall" "$tmp_file"
        fi
    else
        cp -f "$wall" "$tmp_file"
    fi

    chmod 644 "$tmp_file"
    mv -f "$tmp_file" "$dest_file"
    printf '%s\n' "$current_stamp" > "$stamp_file"
    chmod 644 "$stamp_file"
}

sync_palette() {
    local wall="$1"
    command -v python3 >/dev/null 2>&1 || return 0

    python3 - "$target_dir" "$wall" "$force_sync" <<'PYEOF'
import json
import os
import re
import subprocess
import sys
import tempfile

target_dir = sys.argv[1]
wall_path = sys.argv[2]
force = sys.argv[3] == "1"

xdg_cfg = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
xdg_data = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")

def run_cmd(args):
    try:
        res = subprocess.run(args, capture_output=True, text=True, timeout=8)
        if res.returncode == 0:
            return res.stdout.strip()
    except Exception:
        pass
    return ""

def valid_hex(val):
    if isinstance(val, str) and re.fullmatch(r"#[0-9a-fA-F]{6}", val.strip()):
        return val.strip().lower()
    return None

def shift_hex(hex_color, delta):
    c = hex_color.lstrip("#")
    r, g, b = int(c[0:2], 16), int(c[2:4], 16), int(c[4:6], 16)
    step = int(round(255 * delta))
    r = max(0, min(255, r + step))
    g = max(0, min(255, g + step))
    b = max(0, min(255, b + step))
    return f"#{r:02x}{g:02x}{b:02x}"

def extract_from_json_map(m, mode):
    if not isinstance(m, dict):
        return None
    if mode in m and isinstance(m[mode], dict):
        m = m[mode]
    elif "colors" in m and isinstance(m["colors"], dict):
        m = m["colors"]
    elif "dark" in m and isinstance(m["dark"], dict):
        m = m["dark"]

    def pick(*keys):
        for k in keys:
            v = m.get(k)
            if isinstance(v, dict):
                v = v.get("default", v.get("hex"))
                if isinstance(v, dict):
                    v = v.get("hex")
            h = valid_hex(v)
            if h:
                return h
        return None

    surface = pick("mSurface", "surface", "background")
    primary = pick("mPrimary", "primary")
    on_surface = pick("mOnSurface", "on_surface", "onSurface", "foreground")
    if not (surface and primary and on_surface):
        return None

    panel_base = pick("mSurfaceVariant", "surface_container_low", "surface_variant", "surfaceVariant") or shift_hex(surface, 0.025 if mode == "dark" else -0.03)
    panel_focus = pick("mHover", "surface_container_high", "surface_container", "hover") or shift_hex(panel_base, 0.035 if mode == "dark" else -0.04)
    panel_hover = shift_hex(panel_focus, 0.02 if mode == "dark" else -0.025)

    return {
        "surfaceColor": surface,
        "panelBaseColor": panel_base,
        "panelFocusBaseColor": panel_focus,
        "panelHoverBaseColor": panel_hover,
        "primaryColor": primary,
        "primaryForeground": pick("mOnPrimary", "on_primary", "onPrimary") or ("#090909" if mode == "dark" else "#f2f2f2"),
        "tertiaryColor": pick("mTertiary", "tertiary") or primary,
        "errorColor": pick("mError", "error") or "#ff5c5c",
        "textPrimary": pick("mOnHover", "on_background", "on_surface", "mOnSurface") or on_surface,
        "textSecondary": on_surface,
        "textMuted": pick("mOnSurfaceVariant", "on_surface_variant", "onSurfaceVariant") or "#7f7f7f",
    }

def from_custom_palette(name, mode):
    candidates = [
        os.path.join(xdg_cfg, "noctalia", "palettes", f"{name}.json"),
        os.path.join(xdg_cfg, "noctalia", "palettes", name, "palette.json"),
        os.path.join(xdg_data, "noctalia", "palettes", f"{name}.json"),
        os.path.join(xdg_data, "noctalia", "palettes", name, "palette.json"),
    ]
    for path in candidates:
        if os.path.isfile(path):
            try:
                with open(path, "r", encoding="utf-8") as fh:
                    data = json.load(fh)
                parsed = extract_from_json_map(data, mode)
                if parsed:
                    return parsed
            except Exception:
                pass
    return None

def from_wallpaper_scheme(scheme_name, mode):
    if not wall_path or not os.path.isfile(wall_path):
        return None
    flag = "--light" if mode == "light" else "--dark"
    out = run_cmd(["noctalia", "theme", wall_path, "--scheme", scheme_name or "m3-tonal-spot", flag])
    if out:
        try:
            data = json.loads(out)
            parsed = extract_from_json_map(data, mode)
            if parsed:
                return parsed
        except Exception:
            pass
    return None

def from_gtk_css(mode):
    for rel in (("gtk-4.0", "noctalia.css"), ("gtk-3.0", "noctalia.css")):
        path = os.path.join(xdg_cfg, *rel)
        if not os.path.isfile(path):
            continue
        try:
            text = open(path, "r", encoding="utf-8").read()
        except Exception:
            continue
        defs = dict(re.findall(r"@define-color\s+([a-zA-Z0-9_]+)\s+(#[0-9a-fA-F]{6})\s*;", text))
        surface = valid_hex(defs.get("window_bg_color"))
        primary = valid_hex(defs.get("accent_bg_color") or defs.get("accent_color"))
        on_surface = valid_hex(defs.get("window_fg_color"))
        if surface and primary and on_surface:
            panel_base = valid_hex(defs.get("card_bg_color") or defs.get("popover_bg_color")) or shift_hex(surface, 0.025 if mode == "dark" else -0.03)
            panel_focus = shift_hex(panel_base, 0.035 if mode == "dark" else -0.04)
            panel_hover = shift_hex(panel_focus, 0.02 if mode == "dark" else -0.025)
            return {
                "surfaceColor": surface,
                "panelBaseColor": panel_base,
                "panelFocusBaseColor": panel_focus,
                "panelHoverBaseColor": panel_hover,
                "primaryColor": primary,
                "primaryForeground": valid_hex(defs.get("accent_fg_color")) or "#090909",
                "tertiaryColor": valid_hex(defs.get("destructive_bg_color")) or primary,
                "errorColor": valid_hex(defs.get("error_bg_color") or defs.get("destructive_bg_color")) or "#ff5c5c",
                "textPrimary": shift_hex(on_surface, 0.08 if mode == "dark" else -0.05),
                "textSecondary": on_surface,
                "textMuted": shift_hex(on_surface, -0.35 if mode == "dark" else 0.30),
            }
    return None

def from_qt6ct(mode):
    path = os.path.join(xdg_cfg, "qt6ct", "colors", "noctalia.conf")
    if not os.path.isfile(path):
        return None
    try:
        text = open(path, "r", encoding="utf-8").read()
    except Exception:
        return None
    m = re.search(r"^active_colors\s*=\s*(.+)$", text, re.MULTILINE)
    if not m:
        return None
    cols = [c.strip() for c in m.group(1).split(",")]
    if len(cols) < 22:
        return None
    surface = valid_hex(cols[10]) or valid_hex(cols[1])
    panel_base = valid_hex(cols[16]) or surface
    primary = valid_hex(cols[21]) or valid_hex(cols[15])
    on_surface = valid_hex(cols[0])
    if not (surface and primary and on_surface):
        return None
    panel_focus = shift_hex(panel_base, 0.035 if mode == "dark" else -0.04)
    panel_hover = shift_hex(panel_focus, 0.02 if mode == "dark" else -0.025)
    return {
        "surfaceColor": surface,
        "panelBaseColor": panel_base,
        "panelFocusBaseColor": panel_focus,
        "panelHoverBaseColor": panel_hover,
        "primaryColor": primary,
        "primaryForeground": "#090909" if mode == "dark" else "#f2f2f2",
        "tertiaryColor": primary,
        "errorColor": "#ff5c5c",
        "textPrimary": shift_hex(on_surface, 0.08 if mode == "dark" else -0.05),
        "textSecondary": on_surface,
        "textMuted": shift_hex(on_surface, -0.35 if mode == "dark" else 0.30),
    }

mode_raw = run_cmd(["noctalia", "msg", "theme-mode-get"]).lower()
mode = "light" if mode_raw == "light" else "dark"

scheme_raw = run_cmd(["noctalia", "msg", "color-scheme-get"])
palette = None
if scheme_raw:
    parts = scheme_raw.split(None, 1)
    source = parts[0].lower()
    name = parts[1].strip() if len(parts) > 1 else ""
    if source == "custom" and name:
        palette = from_custom_palette(name, mode)
    elif source == "wallpaper":
        palette = from_wallpaper_scheme(name, mode)

if not palette:
    palette = from_gtk_css(mode) or from_qt6ct(mode)

if not palette:
    sys.exit(0)

qml_lines = [
    "// Generated automatically by noctalia-sddm-sync",
    "import QtQuick",
    "",
    "QtObject {",
]
for k, v in palette.items():
    qml_lines.append(f'    readonly property color {k}: "{v}"')
qml_lines.append("}")
qml_content = "\n".join(qml_lines) + "\n"

dest_palette = os.path.join(target_dir, "Palette.qml")
if not force and os.path.isfile(dest_palette):
    try:
        if open(dest_palette, "r", encoding="utf-8").read() == qml_content:
            sys.exit(0)
    except Exception:
        pass

fd, tmp_path = tempfile.mkstemp(prefix=".Palette.", suffix=".qml", dir=target_dir)
try:
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write(qml_content)
    os.chmod(tmp_path, 0o644)
    os.replace(tmp_path, dest_palette)
except Exception:
    try:
        os.unlink(tmp_path)
    except OSError:
        pass
    raise
PYEOF
}

if [ -n "$avatar_src" ]; then
    sync_avatar "$avatar_src"
fi

wallpaper_path=""
if [ "$SYNC_WALLPAPER" = "true" ] || [ "$SYNC_COLORS" = "true" ]; then
    wallpaper_path="$(get_wallpaper)"
    wallpaper_path="${wallpaper_path#file://}"
fi

if [ "$SYNC_WALLPAPER" = "true" ]; then
    sync_wallpaper "$wallpaper_path"
fi

if [ "$SYNC_COLORS" = "true" ]; then
    sync_palette "$wallpaper_path"
fi
